    "onboarding.privacy.retention": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raw audio is deleted after seven days by default. You choose."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio brut est supprimé au bout de sept jours par défaut. C'est toi qui choisis."
