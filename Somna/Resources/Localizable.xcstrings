    "settings.medicalDisclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Somna is not a medical device. It does not diagnose anything, does not detect sleep apnea, and does not measure sleep stages. If you are worried about your sleep, talk to a doctor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Somna n'est pas un dispositif médical. Elle ne pose aucun diagnostic, ne détecte pas l'apnée du sommeil et ne mesure pas les phases de sommeil. Si ton sommeil t'inquiète, parles-en à un médecin."
          }
        }
      }
    },
    "settings.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun"
          }
        }
      }
    },
    "settings.notInThisVersion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not in this version"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas dans cette version"
          }
        }
      }
    },
    "settings.notifications.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Somna never comments on how you slept — it does not know. The report notification is sent when an analysis actually finishes, not on a timer, so it never announces a night you did not record."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Somna ne commente jamais la façon dont tu as dormi — elle ne le sait pas. La notification de rapport part quand une analyse se termine vraiment, pas sur une minuterie : elle n'annoncera jamais une nuit que tu n'as pas enregistrée."
          }
        }
      }
    },
    "settings.palette": {
      "extractionState": "manual",
      "localizations": {
