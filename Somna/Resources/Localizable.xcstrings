    "settings.storage.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A full night is about 115 MB of raw audio, or about 10 MB once only the event clips remain. Clips are never removed by retention — they are what lets you check each detection."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une nuit complète pèse environ 115 Mo d'audio brut, ou environ 10 Mo une fois réduite à ses extraits. Les extraits ne sont jamais supprimés par la rétention : ce sont eux qui te permettent de vérifier chaque détection."
          }
        }
      }
    },
