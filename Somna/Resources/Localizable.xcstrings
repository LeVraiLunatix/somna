      }
    },
    "onboarding.calibration.needsMic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibration needs the microphone. You can do it later from Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La calibration a besoin du micro. Tu pourras la faire plus tard depuis les Réglages."
          }
        }
      }
    },
    "onboarding.calibration.start": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure now"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesurer maintenant"
          }
        }
      }
    },
    "onboarding.calibration.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fifteen seconds of quiet, so Somna knows what quiet sounds like here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quinze secondes de silence, pour que Somna sache à quoi ressemble le calme chez toi."
          }
        }
      }
    },
    "onboarding.calibration.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure your room"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesurer ta chambre"
          }
        }
      }
    },
    "onboarding.finish": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start using Somna"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencer à utiliser Somna"
          }
        }
      }
    },
    "onboarding.how.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Somna before you go to sleep."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance Somna avant de t'endormir."
          }
        }
      }
    },
    "onboarding.how.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave your iPhone near the bed, plugged in."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisse ton iPhone près du lit, branché."
          }
        }
      }
    },
    "onboarding.how.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read your night in the morning."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découvre ta nuit au réveil."
          }
        }
      }
    },
    "onboarding.how.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three things, once a night."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois choses, une fois par nuit."
          }
        }
      }
    },
    "onboarding.how.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How it works"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment ça marche"
          }
        }
      }
    },
    "onboarding.limits.can": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It detects likely sounds: snoring, coughing, speech, doors, rain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle détecte des sons probables : ronflements, toux, paroles, portes, pluie."
          }
        }
      }
    },
    "onboarding.limits.mistakes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It gets things wrong sometimes. Every event keeps its audio so you can check."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle se trompe parfois. Chaque événement garde son audio pour que tu puisses vérifier."
          }
        }
      }
    },
    "onboarding.limits.noCamera": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It never uses the camera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle n'utilise jamais la caméra."
          }
        }
      }
    },
    "onboarding.limits.noMedical": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is not a medical device and makes no diagnosis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est pas un dispositif médical et elle ne pose aucun diagnostic."
          }
        }
      }
    },
    "onboarding.limits.noMovement": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It cannot tell how you moved, only what it heard."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle ne sait pas comment tu as bougé, seulement ce qu'elle a entendu."
          }
        }
      }
    },
    "onboarding.limits.sharedRoom": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you share a room, Somna cannot tell who made a sound. It will say “snoring detected”, never “you snored”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu partages ta chambre, Somna ne peut pas savoir qui a fait un son. Elle dira « ronflement détecté », jamais « tu as ronflé »."
          }
        }
      }
    },
