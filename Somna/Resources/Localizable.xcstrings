      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Somna listens while you sleep and builds a timeline of what happened, so you can hear it for yourself in the morning."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Somna écoute pendant que tu dors et construit une chronologie de ce qui s'est passé, pour que tu puisses l'écouter toi-même au réveil."
          }
        }
      }
