    "home.first.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put your iPhone within a metre of the bed, plug it in, and start Somna before you fall asleep."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose ton iPhone à moins d'un mètre du lit, branche-le, et lance Somna avant de t'endormir."
          }
        }
      }
    },
    "home.first.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first night"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta première nuit"
          }
        }
      }
    },
    "home.first.warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do not swipe Somna away from the app switcher during the night — iOS would end the recording for good."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne balaie pas Somna hors du sélecteur d'apps pendant la nuit — iOS mettrait définitivement fin à l'enregistrement."
          }
        }
      }
    },
