    "premium.freeForever": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording, analysis, reports and deletion will stay free. Nothing that already works today will move behind a payment."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement, l'analyse, les rapports et la suppression resteront gratuits. Rien de ce qui fonctionne aujourd'hui ne passera derrière un paiement."
          }
        }
      }
    },
    "premium.history.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep every night, instead of the most recent ones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder toutes les nuits, au lieu des plus récentes."
          }
        }
