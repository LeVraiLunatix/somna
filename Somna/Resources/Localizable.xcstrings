    "settings.premium": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What might come later"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui pourrait arriver plus tard"
          }
        }
      }
    },
    "settings.privacy.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Somna has no account and no server. Nothing is ever uploaded, and no speech is ever transcribed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Somna n'a ni compte ni serveur. Rien n'est jamais envoyé, et aucune parole n'est jamais transcrite."
          }
        }
      }
    },
