    "analysis.classifier.suggestion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recording is safe. Try analysing it again from the night's page."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton enregistrement est intact. Réessaie l'analyse depuis la page de la nuit."
