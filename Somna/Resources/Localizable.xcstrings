    "calibration.stale": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This measurement is over a month old. Rooms change — a new one takes fifteen seconds."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette mesure a plus d'un mois. Les pièces changent — une nouvelle prend quinze secondes."
          }
        }
      }
    },
    "calibration.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Room calibration"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibration de la pièce"
          }
        }
      }
    },
    "calibration.why": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why this matters"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi c'est utile"
          }
        }
      }
    },
    "calibration.why.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Somna compares every sound to how quiet your room is when nothing is happening. Without that reference it falls back to values that match no particular bedroom, and detection gets noticeably less reliable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Somna compare chaque son au niveau de calme de ta chambre quand rien ne se passe. Sans cette référence, elle retombe sur des valeurs qui ne correspondent à aucune chambre en particulier, et la détection devient nettement moins fiable."
          }
        }
      }
    },
    "error.corruptedFile.suggestion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rest of the night is unaffected. This clip has been skipped."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le reste de la nuit n'est pas affecté. Cet extrait a été ignoré."
          }
        }
      }
    },
