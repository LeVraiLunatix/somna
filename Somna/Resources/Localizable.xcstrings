    "settings.recording.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A stricter sensitivity means fewer detections, and the ones you get are surer. Higher quality roughly doubles the space a night uses. The wake alarm rings even in silent mode, and ends the recording when it does."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une sensibilité plus stricte donne moins de détections, mais plus sûres. La qualité supérieure double environ l'espace occupé par une nuit."
          }
        }
      }
    },
