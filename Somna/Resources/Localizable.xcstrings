    "summary.nothingDetected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Somna did not detect anything at all. Either the night was remarkably quiet, or the microphone was not picking much up."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Somna n'a rien détecté du tout. Soit la nuit a été remarquablement calme, soit le micro ne captait pas grand-chose."
          }
        }
      }
    },
