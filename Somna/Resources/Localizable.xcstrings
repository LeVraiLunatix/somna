    "trends.accessibility.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Average %1$@ %2$@ over %3$lld nights."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moyenne de %1$@ %2$@ sur %3$lld nuits."
          }
        }
      }
    },
    "trends.average": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Average: %1$@ %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moyenne : %1$@ %2$@"
          }
        }
      }
    },
    "trends.calmness.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The calmness score of each night, 0 to 100. It reflects how quiet the recording was, not how well you slept."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le score de tranquillité de chaque nuit, de 0 à 100. Il reflète le calme sonore de l'enregistrement, pas la qualité de ton sommeil."
          }
        }
      }
    },
    "trends.calmness.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How quiet your nights were"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le calme de tes nuits"
          }
        }
      }
    },
    "trends.coughs.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many coughs were detected each night. A cough can be missed, and other sounds can be mistaken for one."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre de toux détectées chaque nuit. Une toux peut passer inaperçue, et d'autres sons peuvent être pris pour une toux."
          }
        }
      }
    },
    "trends.coughs.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coughs detected"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toux détectées"
          }
        }
      }
    },
    "trends.coverage.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The share of each session Somna managed to record. A dip here means interruptions, and makes that night's other numbers less reliable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La part de chaque session que Somna a réussi à enregistrer. Une baisse signale des interruptions, et rend les autres chiffres de cette nuit moins fiables."
          }
        }
      }
    },
    "trends.coverage.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much was actually captured"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Part réellement captée"
          }
        }
      }
    },
    "trends.duration.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hours of audio captured each night. This is recording time, not sleep time — Somna cannot tell when you fell asleep."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Heures d'audio captées chaque nuit. C'est du temps d'enregistrement, pas du temps de sommeil — Somna ne sait pas quand tu t'es endormi."
          }
        }
      }
    },
    "trends.duration.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long you recorded"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durée d'enregistrement"
          }
        }
      }
    },
    "trends.empty.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Somna has %1$lld analysed nights and needs %2$lld before showing trends. A line through two points is not a trend, and drawing one would say more than the data can."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Somna a %1$lld nuits analysées et en attend %2$lld avant d'afficher des tendances. Une ligne entre deux points n'est pas une tendance, et la tracer dirait plus que les données ne permettent."
          }
        }
      }
    },
