    "home.recordingSoon.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build sets up everything around recording — permissions, storage, calibration. The audio engine itself arrives in the next one."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version met en place tout ce qui entoure l'enregistrement : autorisations, stockage, calibration. Le moteur audio arrive dans la prochaine."
          }
        }
      }
    },
    "home.recordingSoon.title": {
      "extractionState": "manual",
      "localizations": {
