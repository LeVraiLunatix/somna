    "onboarding.calibration.allGood": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This spot works well. You are ready for tonight."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet emplacement fonctionne bien. Tu es prêt pour cette nuit."
          }
        }
      }
    },
    "onboarding.calibration.instruction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put your iPhone where it will spend the night, then stay quiet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose ton iPhone là où il passera la nuit, puis reste silencieux."
          }
        }
      }
    },
    "onboarding.calibration.measuring": {
