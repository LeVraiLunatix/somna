    "home.calmnessNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calmness reflects how quiet the recording was. It is not a measure of sleep quality."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tranquillité reflète le calme sonore de l'enregistrement. Ce n'est pas une mesure de ton sommeil."
          }
        }
      }
    },
    "home.diagnostics": {
