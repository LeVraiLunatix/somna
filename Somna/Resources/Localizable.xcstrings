            "value": "Historique illimité"
          }
        }
      }
    },
    "premium.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None of this exists yet, and nothing here can be bought. It is a sketch of where Somna could go — tell me which of these you would actually use."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de tout cela n'existe encore, et rien ici ne peut être acheté. C'est une esquisse de ce que Somna pourrait devenir — dis-moi ce que tu utiliserais vraiment."
          }
        }
      }
    },
    "premium.models.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Improved on-device models as they become available."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des modèles embarqués améliorés à mesure qu'ils arrivent."
