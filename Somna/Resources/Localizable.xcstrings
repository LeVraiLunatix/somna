    "error.microphone.suggestion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow microphone access for Somna in iOS Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise l'accès au micro pour Somna dans les Réglages iOS."
