    "action.retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayer"
          }
        }
      }
    },
    "audio.engineFailed.suggestion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again. If it keeps happening, restart your iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessaie. Si cela se reproduit, redémarre ton iPhone."
          }
        }
      }
    },
    "audio.engineFailed.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording could not start"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement n'a pas pu démarrer"
          }
        }
      }
    },
    "audio.inputUnavailable.suggestion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If headphones or an external microphone are connected, try disconnecting them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un casque ou un micro externe est branché, essaie de le débrancher."
          }
        }
      }
    },
    "audio.inputUnavailable.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No microphone input available"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune entrée micro disponible"
          }
        }
      }
    },
    "audio.interrupted.suggestion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What was recorded before the interruption has been kept."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui a été enregistré avant l'interruption a été conservé."
          }
        }
      }
    },
    "audio.interrupted.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording was interrupted"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement a été interrompu"
          }
        }
      }
    },
    "audio.sessionUnavailable.suggestion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another app may be using the microphone. Close it and try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre app utilise peut-être le micro. Ferme-la et réessaie."
          }
        }
      }
    },
    "audio.sessionUnavailable.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Somna could not access the microphone"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Somna n'a pas pu accéder au micro"
          }
        }
      }
    },
    "calibration.issue.highAmbientNoise": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The room is quite noisy. A fan or an open window will mask quieter sounds."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pièce est assez bruyante. Un ventilateur ou une fenêtre ouverte masquera les sons les plus faibles."
          }
        }
      }
    },
    "calibration.issue.noInput": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Somna is not picking up any sound. Check that nothing is covering the bottom of your iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Somna ne capte aucun son. Vérifie que rien ne couvre le bas de ton iPhone."
          }
        }
      }
    },
    "calibration.issue.unstableEnvironment": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The noise level kept changing. Try again once the room has settled."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le niveau sonore n'a cessé de varier. Réessaie quand la pièce sera calme."
          }
        }
      }
    },
    "calibration.issue.veryQuietInput": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The signal is very faint. Move your iPhone closer to the bed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le signal est très faible. Rapproche ton iPhone du lit."
          }
        }
      }
    },
