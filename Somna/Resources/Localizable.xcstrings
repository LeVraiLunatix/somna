    "error.environment.suggestion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close and reopen Somna. If it happens again, please report it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferme et rouvre Somna. Si cela se reproduit, signale-le."
          }
        }
      }
    },
    "error.environment.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Somna is not ready yet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Somna n'est pas encore prête"
          }
        }
      }
