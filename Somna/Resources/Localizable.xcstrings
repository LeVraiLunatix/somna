    "summary.qualityUnusable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording was too degraded to draw anything from. This says nothing about your night — only about the audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement est trop dégradé pour en tirer quoi que ce soit. Cela ne dit rien de ta nuit — seulement de l'audio."
          }
        }
      }
    },
