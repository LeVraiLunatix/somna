    "onboarding.privacy.noTranscription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Somna never transcribes what is said — yours or anyone else's."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Somna ne transcrit jamais ce qui est dit — ni par toi, ni par personne d'autre."
