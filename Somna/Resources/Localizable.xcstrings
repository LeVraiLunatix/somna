    "settings.accessibility.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Somna follows your iOS settings for text size, Reduce Motion, Reduce Transparency and Increase Contrast. Every event is labelled in words, so nothing depends on colour alone, and haptics never carry information on their own."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Somna suit tes réglages iOS pour la taille du texte, Réduire les animations, Réduire la transparence et Augmenter le contraste. Chaque événement est décrit en mots, donc rien ne dépend de la couleur seule, et les retours haptiques ne portent jamais d'information à eux seuls."
          }
        }
      }
    },
