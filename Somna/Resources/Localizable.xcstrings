    "onboarding.limits.can": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It detects likely sounds: snoring, coughing, speech, doors, rain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle détecte des sons probables : ronflements, toux, paroles, portes, pluie."
          }
        }
      }
    },
    "onboarding.limits.mistakes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It gets things wrong sometimes. Every event keeps its audio so you can check."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle se trompe parfois. Chaque événement garde son audio pour que tu puisses vérifier."
          }
        }
      }
    },
    "onboarding.limits.noCamera": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It never uses the camera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle n'utilise jamais la caméra."
          }
        }
      }
    },
    "onboarding.limits.noMedical": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is not a medical device and makes no diagnosis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est pas un dispositif médical et elle ne pose aucun diagnostic."
          }
        }
      }
    },
    "onboarding.limits.noMovement": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It cannot tell how you moved, only what it heard."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle ne sait pas comment tu as bougé, seulement ce qu'elle a entendu."
          }
        }
      }
    },
    "onboarding.limits.sharedRoom": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you share a room, Somna cannot tell who made a sound. It will say “snoring detected”, never “you snored”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu partages ta chambre, Somna ne peut pas savoir qui a fait un son. Elle dira « ronflement détecté », jamais « tu as ronflé »."
          }
        }
      }
    },
    "onboarding.limits.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Worth knowing before you rely on it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À savoir avant de lui faire confiance."
          }
        }
      }
    },
    "onboarding.limits.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Somna can and cannot do"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que Somna peut et ne peut pas faire"
          }
        }
      }
    },
