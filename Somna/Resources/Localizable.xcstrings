    "status.privacyNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything stays on this iPhone. Somna has no account, no server, and never uploads audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout reste sur cet iPhone. Somna n'a ni compte, ni serveur, et n'envoie jamais d'audio."
          }
        }
      }
    },
    "status.ready": {
