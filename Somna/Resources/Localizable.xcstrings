    "session.prepare.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Somna will listen until you stop it. It keeps recording with the screen locked."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Somna écoutera jusqu'à ce que tu l'arrêtes. L'enregistrement continue écran verrouillé."
