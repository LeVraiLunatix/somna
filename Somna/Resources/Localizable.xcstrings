    "status.readyDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your iPhone plugged in and within a metre of the bed. Do not swipe Somna away while it records."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde ton iPhone branché et à moins d'un mètre du lit. Ne balaie pas Somna hors du sélecteur d'apps pendant l'enregistrement."
          }
        }
      }
    },
