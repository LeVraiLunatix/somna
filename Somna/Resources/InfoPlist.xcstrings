{
  "sourceLanguage": "en",
  "strings": {
    "NSAlarmKitUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Somna rings the wake alarm you set, and ends the night's recording when it does."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Somna fait sonner le réveil que tu as réglé, et met fin à l'enregistrement de la nuit quand il sonne."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Somna listens to the sounds of your night so it can build a timeline of what happened while you slept. Audio never leaves your iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Somna écoute les sons de ta nuit pour construire au réveil une chronologie de ce qui s'est passé. L'audio ne quitte jamais ton iPhone."
          }
        }
      }
    }
  },
  "version": "1.0"
}
